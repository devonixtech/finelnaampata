{
  "name": "hyperlocal-discovery-platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run start:dev --workspace=@business-saas/api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "build:web": "npm run build --workspace=@apps/web",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:web && npm run build:backend",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run start:prod --prefix backend",
    "start:prod": "npm run start:prod --prefix backend",
    "debug:dist": "ls -R backend/dist"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "concurrently": "^9.2.1",
    "rxjs": "7.8.1",
    "tailwindcss": "^3.4.1",
    "turbo": "latest"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.1"
  },
  "dependencies": {
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "react-native-image-picker": "^8.2.1",
    "socket.io-client": "^4.8.3"
  }
}
